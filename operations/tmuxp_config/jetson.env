# Bash settings, sourced by start.sh and every live pane. Use absolute paths; spaces are supported.
# Defaults match the inspected AGX Humble installation; environment overrides win.
: "${AAC_WORKSPACE:=$HOME/f1tenth_ws}"
: "${AAC_LIVE_DIR:=$AAC_WORKSPACE/live_indoor}"
: "${AAC_ROS_SETUP:=/opt/ros/humble/setup.bash}"
: "${AAC_MANUAL_SETUP:=$AAC_WORKSPACE/install/manual/setup.bash}"
: "${AAC_LIDAR_SETUP:=$AAC_WORKSPACE/install/lidar/setup.bash}"
: "${AAC_LOCALIZATION_SETUP:=$AAC_LIVE_DIR/install/local_setup.bash}"
: "${AAC_MSG_SETUP:=$AAC_LIVE_DIR/msg-install/local_setup.bash}"
: "${AAC_MANUAL_CONFIG:=$AAC_WORKSPACE/src/aac_2026/system/f1tenth_manual/config/manual.car.yaml}"
: "${AAC_MAP_DIR:=$AAC_LIVE_DIR/map}"
: "${AAC_TRACK_CSV:=$AAC_LIVE_DIR/track/track.csv}"
: "${AAC_ACADOS_DIR:=$AAC_LIVE_DIR/acados}"
: "${AAC_MPCC_PYTHON:=$AAC_LIVE_DIR/acados-venv/bin/python}"
: "${AAC_DDS_PROFILE:=$AAC_LIVE_DIR/fastdds-peer.xml}"
: "${AAC_SENSOR_DOMAIN:=43}"
: "${AAC_MANUAL_DOMAIN:=42}"

# REQUIRED: auto for global lidar initialization, or map-frame [x,y,z,roll,pitch,yaw] in m/rad.
# Do not reuse a bag's starting pose unless the car is at that same pose.
: "${AAC_INITIAL_BASE_POSE:=}"

# Built-in indoor autonomy: explicit calibration path; hardware output defaults off.
: "${AAC_AUTONOMY_PROFILE:=}"
: "${AAC_AUTONOMY_HARDWARE:=0}"

# Alternatively supply both custom executable startup scripts.
: "${AAC_CONTROL_START:=}"
: "${AAC_VEHICLE_START:=}"
