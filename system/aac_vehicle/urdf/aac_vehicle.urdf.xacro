<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="aac_vehicle">

  <!-- ============================================================
       Vehicle parameters — AAC 2026 scale car platform
         Body: 99 x 55 x 41 cm
  ============================================================ -->
  <xacro:property name="wheelbase"      value="0.80"/>   <!-- [m] axle-to-axle -->
  <xacro:property name="track_width"    value="0.46"/>   <!-- [m] center-to-center -->
  <xacro:property name="wheel_radius"   value="0.08"/>   <!-- [m] -->
  <xacro:property name="wheel_width"    value="0.055"/>  <!-- [m] -->

  <xacro:property name="chassis_length" value="0.99"/>   <!-- [m] -->
  <xacro:property name="chassis_width"  value="0.55"/>   <!-- [m] -->
  <xacro:property name="chassis_height" value="0.25"/>   <!-- [m] body slab height -->

  <xacro:property name="chassis_mass"   value="15.0"/>   <!-- [kg] -->
  <xacro:property name="wheel_mass"     value="0.5"/>    <!-- [kg] -->

  <!-- Steering limit: mirrors config/vehicle_params.yaml -->
  <xacro:property name="max_steering_angle" value="0.524"/>  <!-- [rad] ~30 deg -->

  <!-- ============================================================
       Inertia helpers
  ============================================================ -->
  <xacro:macro name="box_inertia" params="m l w h">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${m*(w*w + h*h)/12}" ixy="0" ixz="0"
        iyy="${m*(l*l + h*h)/12}" iyz="0"
        izz="${m*(l*l + w*w)/12}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <!-- cylinder axis along Y (wheel rotates around Y) -->
      <inertia
        ixx="${m*(3*r*r + h*h)/12}" ixy="0" ixz="0"
        iyy="${m*r*r/2}"            iyz="0"
        izz="${m*(3*r*r + h*h)/12}"/>
    </inertial>
  </xacro:macro>

  <!-- ============================================================
       base_footprint  (ground reference, z = 0)
  ============================================================ -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- Chassis layout (base_link frame: x=0 midpoint between axles, z=0 at wheel-center height)
       front axle: x=+0.40  rear axle: x=-0.40  front of car: x=+0.495  rear: x=-0.495
  -->

  <!-- ============================================================
       base_link  (vehicle CG at wheel-center height)
  ============================================================ -->
  <link name="base_link">

    <!-- 1. Lower chassis plate (dark grey) — shows full footprint -->
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} 0.52 0.04"/>
      </geometry>
      <material name="chassis_dark">
        <color rgba="0.20 0.20 0.20 1.0"/>
      </material>
    </visual>

    <!-- 2. Rear body (blue) — spans rear axle to just forward of center -->
    <visual>
      <origin xyz="-0.08 0 0.145" rpy="0 0 0"/>
      <geometry>
        <box size="0.68 0.50 0.21"/>
      </geometry>
      <material name="body_blue">
        <color rgba="0.12 0.32 0.72 1.0"/>
      </material>
    </visual>

    <!-- 3. Front hood (orange) — forward of body, clearly marks the front -->
    <visual>
      <origin xyz="0.345 0 0.09" rpy="0 0 0"/>
      <geometry>
        <box size="0.30 0.44 0.14"/>
      </geometry>
      <material name="hood_orange">
        <color rgba="0.92 0.42 0.00 1.0"/>
      </material>
    </visual>

    <!-- 4. Cockpit (light grey, semi-transparent) -->
    <visual>
      <origin xyz="-0.06 0 0.275" rpy="0 0 0"/>
      <geometry>
        <box size="0.28 0.38 0.10"/>
      </geometry>
      <material name="cockpit_grey">
        <color rgba="0.72 0.75 0.80 0.75"/>
      </material>
    </visual>

    <!-- Collision: single box covering the full chassis volume -->
    <collision>
      <origin xyz="0 0 ${chassis_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${chassis_mass}"
                       l="${chassis_length}"
                       w="${chassis_width}"
                       h="${chassis_height}"/>
  </link>

  <!-- ============================================================
       Wheel macro — cylinder, axis along Y
  ============================================================ -->
  <xacro:macro name="wheel_link" params="name">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wheel_dark">
          <color rgba="0.15 0.15 0.15 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}"
                              r="${wheel_radius}"
                              h="${wheel_width}"/>
    </link>
  </xacro:macro>

  <!-- Steering knuckle — shows a mini RGB coordinate frame that rotates with the
       steering joint, matching the ROS convention (R=X forward, G=Y left, B=Z up).
       The red bar visually tracks the wheel heading angle. -->
  <xacro:macro name="steering_link" params="name">
    <link name="${name}">

      <!-- X axis — RED (forward, rotates with steering) -->
      <visual>
        <origin xyz="0.06 0 0.10" rpy="0 0 0"/>
        <geometry><box size="0.12 0.008 0.008"/></geometry>
        <material name="axis_red">
          <color rgba="1.0 0.0 0.0 1.0"/>
        </material>
      </visual>

      <!-- Y axis — GREEN (left of wheel) -->
      <visual>
        <origin xyz="0 0.06 0.10" rpy="0 0 0"/>
        <geometry><box size="0.008 0.12 0.008"/></geometry>
        <material name="axis_green">
          <color rgba="0.0 0.8 0.0 1.0"/>
        </material>
      </visual>

      <!-- Z axis — BLUE (up) -->
      <visual>
        <origin xyz="0 0 0.16" rpy="0 0 0"/>
        <geometry><box size="0.008 0.008 0.12"/></geometry>
        <material name="axis_blue">
          <color rgba="0.0 0.3 1.0 1.0"/>
        </material>
      </visual>

      <inertial>
        <mass value="0.01"/>
        <inertia ixx="1e-6" ixy="0" ixz="0"
                 iyy="1e-6" iyz="0" izz="1e-6"/>
      </inertial>
    </link>
  </xacro:macro>

  <!-- ============================================================
       Front-left wheel  (steerable)
  ============================================================ -->
  <xacro:steering_link name="front_left_steering_link"/>
  <joint name="front_left_steering_joint" type="revolute">
    <parent link="base_link"/>
    <child  link="front_left_steering_link"/>
    <origin xyz="${wheelbase/2} ${track_width/2} 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-max_steering_angle}" upper="${max_steering_angle}"
           effort="10.0" velocity="2.0"/>
    <dynamics damping="0.01" friction="0.01"/>
  </joint>

  <xacro:wheel_link name="front_left_wheel"/>
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="front_left_steering_link"/>
    <child  link="front_left_wheel"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.01" friction="0.01"/>
  </joint>

  <!-- ============================================================
       Front-right wheel  (steerable)
  ============================================================ -->
  <xacro:steering_link name="front_right_steering_link"/>
  <joint name="front_right_steering_joint" type="revolute">
    <parent link="base_link"/>
    <child  link="front_right_steering_link"/>
    <origin xyz="${wheelbase/2} ${-track_width/2} 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-max_steering_angle}" upper="${max_steering_angle}"
           effort="10.0" velocity="2.0"/>
    <dynamics damping="0.01" friction="0.01"/>
  </joint>

  <xacro:wheel_link name="front_right_wheel"/>
  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="front_right_steering_link"/>
    <child  link="front_right_wheel"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.01" friction="0.01"/>
  </joint>

  <!-- ============================================================
       Rear-left wheel  (drive)
  ============================================================ -->
  <xacro:wheel_link name="rear_left_wheel"/>
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child  link="rear_left_wheel"/>
    <origin xyz="${-wheelbase/2} ${track_width/2} 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.01" friction="0.01"/>
  </joint>

  <!-- ============================================================
       Rear-right wheel  (drive)
  ============================================================ -->
  <xacro:wheel_link name="rear_right_wheel"/>
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child  link="rear_right_wheel"/>
    <origin xyz="${-wheelbase/2} ${-track_width/2} 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.01" friction="0.01"/>
  </joint>

  <!-- ============================================================
       Gazebo: surface contact properties (Ignition Gazebo)
       Visual colors come from the <material><color> inside each <visual>.
       Gazebo/Classic material overrides are NOT used — they would flatten
       the multi-part chassis back to a single blue box.
  ============================================================ -->
  <gazebo reference="front_left_wheel">
    <mu1>1.0</mu1><mu2>0.8</mu2>
    <kp>1e6</kp><kd>1.0</kd>
  </gazebo>
  <gazebo reference="front_right_wheel">
    <mu1>1.0</mu1><mu2>0.8</mu2>
    <kp>1e6</kp><kd>1.0</kd>
  </gazebo>
  <gazebo reference="rear_left_wheel">
    <mu1>1.0</mu1><mu2>0.8</mu2>
    <kp>1e6</kp><kd>1.0</kd>
  </gazebo>
  <gazebo reference="rear_right_wheel">
    <mu1>1.0</mu1><mu2>0.8</mu2>
    <kp>1e6</kp><kd>1.0</kd>
  </gazebo>

  <!-- ============================================================
       Gazebo: AckermannSteering plugin (Ignition Fortress)

       Subscribes to /ackermann_cmd (Twist via ros_gz_bridge):
         linear.x  = speed [m/s]
         angular.z = steering_angle [rad]  (직접 각도, 각속도 아님)

       Inner/outer 바퀴 각도·속도 계산은 플러그인이 내부 처리.
  ============================================================ -->
  <gazebo>
    <plugin filename="ignition-gazebo-ackermann-steering-system"
            name="ignition::gazebo::systems::AckermannSteering">
      <!-- Drive wheels (rear) -->
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <!-- Steering joints (front) -->
      <left_steering_joint>front_left_steering_joint</left_steering_joint>
      <right_steering_joint>front_right_steering_joint</right_steering_joint>

      <kingpin_width>${track_width}</kingpin_width>
      <steering_limit>${max_steering_angle}</steering_limit>
      <wheel_base>${wheelbase}</wheel_base>
      <wheel_separation>${track_width}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>

      <min_velocity>-3.0</min_velocity>
      <max_velocity>3.0</max_velocity>
      <min_acceleration>-2.0</min_acceleration>
      <max_acceleration>2.0</max_acceleration>

      <topic>/ackermann_cmd</topic>
      <odom_publish_frequency>20</odom_publish_frequency>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
    </plugin>

    <!-- Joint state publisher (RViz) -->
    <plugin filename="ignition-gazebo-joint-state-publisher-system"
            name="ignition::gazebo::systems::JointStatePublisher">
    </plugin>
  </gazebo>

</robot>
