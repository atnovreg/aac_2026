FROM ubuntu:24.04
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates git cmake build-essential python3 python3-dev python3-venv \
    && rm -rf /var/lib/apt/lists/*
COPY .f1tenth-workspace /opt/bootstrap/.f1tenth-workspace
COPY src/aac_2026/control/acados_mpcc/config/acados_versions.json /opt/bootstrap/src/aac_2026/control/acados_mpcc/config/acados_versions.json
COPY src/aac_2026/control/acados_mpcc/requirements/acados.txt /opt/bootstrap/src/aac_2026/control/acados_mpcc/requirements/acados.txt
COPY src/aac_2026/control/acados_mpcc/scripts/setup_acados.sh src/aac_2026/control/acados_mpcc/scripts/acados_python.sh /opt/bootstrap/src/aac_2026/control/acados_mpcc/scripts/
ENV ACADOS_SOURCE_DIR=/opt/acados \
    ACADOS_VENV=/opt/venv \
    LD_LIBRARY_PATH=/opt/acados/lib \
    PATH=/opt/venv/bin:$PATH \
    PYTHONPATH=/ws/src/aac_2026 \
    MPLBACKEND=Agg \
    MPLCONFIGDIR=/tmp/acados-matplotlib \
    PYTHONDONTWRITEBYTECODE=1 \
    OPENBLAS_NUM_THREADS=1 \
    OMP_NUM_THREADS=1
RUN chmod +x /opt/bootstrap/src/aac_2026/control/acados_mpcc/scripts/*.sh && /opt/bootstrap/src/aac_2026/control/acados_mpcc/scripts/setup_acados.sh
RUN rm -rf /tmp/acados-matplotlib \
    && git config --system --add safe.directory /opt/acados
WORKDIR /ws
CMD ["python", "-m", "control.acados_mpcc", "--help"]
